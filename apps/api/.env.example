# Roomie API Environment Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=roomie-jwt-super-secret-key-2026
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# MongoDB Atlas Connection String
# Get your connection string from MongoDB Atlas dashboard -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/roomie?retryWrites=true&w=majority
